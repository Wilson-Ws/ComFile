#!name=广告平台拦截器
#!desc=补充字节跳动广告
#!openUrl=
#!author=Wilson-Ws[https://github.com/Wilson-Ws]
#!tag=去广告
#!homepage=https://github.com/Wilson-Ws
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Website_icon/120px/TencentAd.png
#!date=

[Rule]
AND, ((DOMAIN-KEYWORD, log), (OR, ((DOMAIN-SUFFIX, fqnovel.com), (DOMAIN-KEYWORD, snssdk.com)))), REJECT
AND, ((OR, ((DOMAIN-KEYWORD, log), (DOMAIN-KEYWORD, gecko), (DOMAIN-KEYWORD, ad), (DOMAIN-KEYWORD, game))), (DOMAIN-SUFFIX, zijieapi.com)), REJECT
AND, ((DOMAIN-KEYWORD, log), (DOMAIN-SUFFIX, amemv.com)), REJECT-DICT
AND, ((DOMAIN-KEYWORD, -ad-), (DOMAIN-SUFFIX, byteimg.com)), REJECT
DOMAIN, mon.toutiaocloud.com, REJECT
DOMAIN, mon.toutiaocloud.net, REJECT
DOMAIN, cmpassport.com, REJECT
DOMAIN, ahdohpiechei.com, REJECT-DICT
DOMAIN, souajki.net, REJECT
DOMAIN, vegalb.com, REJECT
DOMAIN, vegslb.com, REJECT
DOMAIN, siomxity.net, REJECT
DOMAIN, sealaly.net, REJECT
DOMAIN, 0kkkkkt.com, REJECT
DOMAIN, dahhxxttxs.com, REJECT
DOMAIN, nexusedgeio.com, REJECT
DOMAIN, ldhy.click, REJECT
DOMAIN, cjjd14.com, REJECT
DOMAIN, manlaxycloud.com, REJECT
DOMAIN, qtaeixd.com, REJECT
DOMAIN, ydycdn.com, REJECT
DOMAIN, jomoxc.com, REJECT
DOMAIN, ksyungslb.com, REJECT
DOMAIN, ctydoh.cn, REJECT
DOMAIN, z1cdn.com, REJECT
DOMAIN, z1cdn.com, REJECT
DOMAIN, dizgslb.com, REJECT
DOMAIN, jspcdn.cn, REJECT
DOMAIN, qnqcdn.net, REJECT
DOMAIN, bjmxy.net, REJECT
DOMAIN, wuchuyun.com, REJECT

[MitM]
hostname=log*.amemv.com, *.ahdohpiechei.com, *.vegslb.com, log.snssdk.com

#!name=广告平台拦截器
#!desc=补充字节跳动广告
#!openUrl=
#!author=Wilson-Ws[https://github.com/Wilson-Ws]
#!tag=去广告
#!homepage=https://github.com/Wilson-Ws
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Website_icon/120px/TencentAd.png
#!date=

[Rule]
AND, ((DOMAIN-KEYWORD, -alismart-), (DOMAIN-SUFFIX, douyinvod.com)), REJECT
AND, ((DOMAIN-KEYWORD, log), (OR, ((DOMAIN-SUFFIX, fqnovel.com), (DOMAIN-KEYWORD, snssdk.com), (DOMAIN-SUFFIX, amemv.com), (DOMAIN-SUFFIX, zijieapi.com)))), REJECT
AND, ((OR, ((DOMAIN-KEYWORD, gecko), (DOMAIN-KEYWORD, ad), (DOMAIN-KEYWORD, game))), (DOMAIN-SUFFIX, zijieapi.com)), REJECT
DOMAIN, sdktt.data.tianwenca.com, REJECT
DOMAIN, privacy.zijieapi.com, REJECT
DOMAIN-SUFFIX, ahdohpiechei.com, REJECT

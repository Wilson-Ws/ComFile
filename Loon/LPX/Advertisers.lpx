#!name=广告平台拦截器
#!desc=补充字节跳动广告
#!openUrl=
#!author=Wilson-Ws[https://github.com/Wilson-Ws]
#!tag=去广告
#!homepage=https://github.com/Wilson-Ws
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Website_icon/120px/TencentAd.png
#!date=

[Rule]
AND, ((PROTOCOL, QUIC), (OR, ((IP-CIDR, 111.6.0.0/16), (IP-CIDR, 111.7.0.0/16), (IP-CIDR, 111.62.0.0/15)))), REJECT
AND, ((PROTOCOL, QUIC), (OR, ((IP-CIDR, 183.201.0.0/16), (IP-CIDR, 183.204.0.0/16), (IP-CIDR, 183.205.0.0/16)))), REJECT
AND, ((DOMAIN-KEYWORD, log), (OR, ((DOMAIN-SUFFIX, amemv.com), (DOMAIN-SUFFIX, fqnovel.com), (DOMAIN-KEYWORD, snssdk.com), (DOMAIN-SUFFIX, zijieapi.com)))), REJECT
AND, ((OR, ((DOMAIN-KEYWORD, abtest), (DOMAIN-KEYWORD, ad), (DOMAIN-KEYWORD, bsync), (DOMAIN-KEYWORD, feedback), (DOMAIN-KEYWORD, game), (DOMAIN-KEYWORD, gecko), (DOMAIN-KEYWORD, mssdk), (DOMAIN-KEYWORD, polaris), (DOMAIN-KEYWORD, saveu), (DOMAIN-KEYWORD, tnc))), (DOMAIN-SUFFIX, zijieapi.com)), REJECT
AND, ((DOMAIN-KEYWORD, analytics), (DOMAIN-SUFFIX, bytescm.com)), REJECT
DOMAIN, abtest-ch.snssdk.com, REJECT
DOMAIN, tr.byteurl.cn, REJECT
DOMAIN, keyhub.zijieapi.com, REJECT
DOMAIN, mcs.zijieapi.com, REJECT
DOMAIN, mon.zijieapi.com, REJECT
DOMAIN, timon.zijieapi.com, REJECT
DOMAIN, privacy.zijieapi.com, REJECT
DOMAIN, sdktt.data.tianwenca.com, REJECT
DOMAIN, security.zijieapi.com, REJECT
DOMAIN, vcs-lf.zijieapi.com, REJECT
DOMAIN-SUFFIX, ahdohpiechei.com, REJECT
DOMAIN-SUFFIX, bdcgslb.com, REJECT
DOMAIN-SUFFIX, bsgslb.cn, REJECT
DOMAIN-SUFFIX, byte456.com, REJECT
DOMAIN-SUFFIX, cjjd14.com, REJECT
DOMAIN-SUFFIX, dizgslb.com, REJECT
DOMAIN-SUFFIX, ecombdapi.com, REJECT
DOMAIN-SUFFIX, ecombdpage.com, REJECT
DOMAIN-SUFFIX, ecombdvod.com, REJECT
DOMAIN-SUFFIX, ksyungslb.com, REJECT
DOMAIN-SUFFIX, kuiniuca.com, REJECT
DOMAIN-SUFFIX, ndcpp.com, REJECT
DOMAIN-SUFFIX, qiezibenpao.com, REJECT
DOMAIN-SUFFIX, qrstuvwxyzab.com, REJECT
DOMAIN-SUFFIX, vegalb.com, REJECT
DOMAIN-SUFFIX, vegslb.com, REJECT
DOMAIN-SUFFIX, wmzfylgdsz.com, REJECT
DOMAIN-SUFFIX, wuchuyun.com, REJECT
DOMAIN-SUFFIX, wuchuyun.net, REJECT
DOMAIN-SUFFIX, xinqiucc.com, REJECT
DOMAIN-SUFFIX, yingt.fun, REJECT
DOMAIN-KEYWORD, mon.toutiaocloud.com, REJECT
DOMAIN-KEYWORD, mon.toutiaocloud.net, REJECT

[MitM]
hostname=*log*.amemv.com, log*.snssdk.com, bsync*.zijieapi.com, mssdk*.zijieapi.com, polaris*.zijieapi.com, saveu*.zijieapi.com, *.vegslb.com, *.ahdohpiechei.com, keyhub.zijieapi.com

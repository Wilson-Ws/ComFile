#!name=广告平台拦截器
#!desc=补充字节跳动广告
#!openUrl=
#!author=Wilson-Ws[https://github.com/Wilson-Ws]
#!tag=去广告
#!homepage=https://github.com/Wilson-Ws
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Website_icon/120px/TencentAd.png
#!date=

[Rule]
AND, ((DOMAIN-KEYWORD, log), (OR, ((DOMAIN-SUFFIX, fqnovel.com), (DOMAIN-KEYWORD, snssdk.com)))), REJECT
AND, ((DOMAIN-KEYWORD, series), (DOMAIN-SUFFIX, douyinvod.com)), REJECT
AND, ((OR, ((DOMAIN-KEYWORD, log), (DOMAIN-KEYWORD, gecko), (DOMAIN-KEYWORD, ad), (DOMAIN-KEYWORD, game))), (DOMAIN-SUFFIX, zijieapi.com)), REJECT
AND, ((DOMAIN-KEYWORD, log), (DOMAIN-SUFFIX, amemv.com)), REJECT-DICT
DOMAIN, bytelink100-ws-lf.amemv.com, REJECT
DOMAIN, sdktt.data.tianwenca.com, REJECT
DOMAIN-KEYWORD, mon.toutiaocloud.com, REJECT
DOMAIN-KEYWORD, mon.toutiaocloud.net, REJECT
DOMAIN-KEYWORD, souajki.net, REJECT
DOMAIN-KEYWORD, vegalb.com, REJECT
DOMAIN-KEYWORD, vegslb.com, REJECT
DOMAIN-KEYWORD, siomxity.net, REJECT
DOMAIN-KEYWORD, sealaly.net, REJECT
DOMAIN-KEYWORD, 0kkkkkt.com, REJECT
DOMAIN-KEYWORD, nexusedgeio.com, REJECT
DOMAIN-KEYWORD, ldhy.click, REJECT
DOMAIN-KEYWORD, cjjd14.com, REJECT
DOMAIN-KEYWORD, qtaeixd.com, REJECT
DOMAIN-KEYWORD, jomoxc.com, REJECT
DOMAIN-KEYWORD, ksyungslb.com, REJECT
DOMAIN-KEYWORD, ctydoh.cn, REJECT
DOMAIN-KEYWORD, dizgslb.com, REJECT
DOMAIN-KEYWORD, jspcdn.cn, REJECT
DOMAIN-KEYWORD, qnqcdn.net, REJECT
DOMAIN-KEYWORD, bjmxy.net, REJECT
DOMAIN-KEYWORD, wuchuyun.com, REJECT
DOMAIN-KEYWORD, wuchuyun.net, REJECT
DOMAIN-KEYWORD, comfylink.com, REJECT
DOMAIN-KEYWORD, ndcpp.com, REJECT

[MitM]
hostname=log*.amemv.com, *.vegslb.com, log.snssdk.com
